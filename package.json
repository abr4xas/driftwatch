{
  "name": "driftwatch",
  "version": "0.0.0",
  "private": true,
  "description": "Encuentra las partes de tu CLAUDE.md, AGENTS.md y skills que ya no son ciertas",
  "license": "MIT",
  "type": "module",
  "bin": {
    "driftwatch": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test && prettier --check .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "corpus": "node --experimental-strip-types scripts/corpus.ts"
  },
  "packageManager": "pnpm@11.21.0",
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.5.0",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "ignore": "^7.0.8",
    "picocolors": "^1.1.1",
    "remark-parse": "^11.0.0",
    "tinyglobby": "^0.2.17",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0"
  }
}
