{
  "name": "@abr4xas/driftwatch",
  "version": "0.4.0",
  "description": "Find the parts of your CLAUDE.md, AGENTS.md and skills that are no longer true",
  "keywords": [
    "claude",
    "claude-code",
    "claude-md",
    "agents-md",
    "agents",
    "skills",
    "cli",
    "lint",
    "documentation",
    "drift",
    "ai",
    "codex",
    "cursor"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "author": "angel cruz (https://github.com/abr4xas)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abr4xas/driftwatch.git"
  },
  "homepage": "https://github.com/abr4xas/driftwatch#readme",
  "bugs": "https://github.com/abr4xas/driftwatch/issues",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "driftwatch": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsdown",
    "pack:check": "node --experimental-strip-types scripts/release/check-tarball.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src test scripts && prettier --check .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "corpus": "node --experimental-strip-types scripts/corpus/run.ts",
    "jev:classify": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types scripts/jev/classify.ts",
    "jev:classes": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types scripts/jev/classes.ts",
    "jev:review": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types scripts/jev/review.ts",
    "discovery": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --experimental-strip-types scripts/discovery/cli.ts",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "packageManager": "pnpm@11.21.0",
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.5.0",
    "ai": "^7.0.106",
    "oxlint": "^1.82.0",
    "prettier": "^3.9.6",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "ignore": "^7.0.8",
    "picocolors": "^1.1.1",
    "remark-parse": "^11.0.0",
    "tinyglobby": "^0.2.17",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0"
  }
}
